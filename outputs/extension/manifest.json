{
  "manifest_version": 3,
  "name": "KOL Wallet Tracker — $KWT Alpha Drops",
  "description": "Stay ahead of every Solana KOL move with instant meme alerts, live wallet pings, and one-click mint links.",
  "version": "0.1.0",
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "assets/icon-16.png",
      "32": "assets/icon-32.png",
      "48": "assets/icon-48.png",
      "128": "assets/icon-128.png"
    }
  },
  "icons": {
    "16": "assets/icon-16.png",
    "32": "assets/icon-32.png",
    "48": "assets/icon-48.png",
    "128": "assets/icon-128.png"
  },
  "permissions": [],
  "host_permissions": [
    "https://kolwallettracker.xyz/*",
    "https://twitter.com/*",
    "https://x.com/*",
    "https://pump.fun/*"
  ],
  "offline_enabled": false
}
