{
  "$schema": "https://v0.dev/schema/landing-page.json",
  "meta": {
    "title": "{{projectName}} — Solana Meme-Coin Launchpad",
    "description": "{{projectName}} (${{ticker}}) is {{elevatorPitch}}",
    "ogImage": "../images/final/1024/{{slug}}-hero.png",
    "favIcon": "../images/final/128/{{slug}}-hero.png"
  },
  "theme": {
    "primary": "#7F5AF0",
    "secondary": "#2CB67D",
    "accent": "#F8D210",
    "background": "#0F172A",
    "surface": "#111827",
    "text": "#F8FAFC",
    "fonts": {
      "heading": "Space Grotesk",
      "body": "Inter"
    }
  },
  "hero": {
    "badge": "Powered by Solana Speed",
    "headline": "{{projectName}} is Goated on the Chain",
    "subheadline": "{{tagline}}",
    "cta": {
      "label": "Mint ${{ticker}}",
      "href": "{{mintUrl}}"
    },
    "secondaryCta": {
      "label": "Read the Lore",
      "href": "#lore"
    },
    "image": "../images/final/1024/{{slug}}-hero.png",
    "alt": "{{heroAlt}}"
  },
  "sections": [
    {
      "id": "lore",
      "type": "text-media",
      "heading": "Why {{projectName}} Exists",
      "body": "{{lore}}",
      "media": {
        "type": "video",
        "src": "{{loreVideoUrl}}",
        "fallbackImage": "../images/final/512/{{slug}}-hero.png"
      }
    },
    {
      "id": "tokenomics",
      "type": "stats",
      "heading": "${{ticker}} Tokenomics",
      "items": [
        { "label": "Total Supply", "value": "{{totalSupply}}" },
        { "label": "Liquidity Lock", "value": "{{liquidityLock}}" },
        { "label": "Community Airdrop", "value": "{{airdropPercent}}" },
        { "label": "Treasury", "value": "{{treasuryPercent}}" }
      ],
      "cta": {
        "label": "View on Solscan",
        "href": "{{solscanUrl}}"
      }
    },
    {
      "id": "roadmap",
      "type": "timeline",
      "heading": "Speedrun Roadmap",
      "items": [
        { "label": "Phase 1 — Meme Genesis", "description": "{{phase1}}" },
        { "label": "Phase 2 — Community Blitz", "description": "{{phase2}}" },
        { "label": "Phase 3 — Utility Drop", "description": "{{phase3}}" }
      ]
    },
    {
      "id": "faq",
      "type": "accordion",
      "heading": "Degens Ask, We Answer",
      "items": [
        { "question": "How do I mint ${{ticker}}?", "answer": "{{faqMint}}" },
        { "question": "What’s the utility?", "answer": "{{faqUtility}}" },
        { "question": "Where’s the community?", "answer": "{{faqCommunity}}" },
        { "question": "Is this financial advice?", "answer": "Absolutely not. {{faqDisclaimer}}" }
      ]
    }
  ],
  "footer": {
    "cta": {
      "label": "Join the {{projectName}} Horde",
      "href": "{{discordUrl}}"
    },
    "links": [
      { "label": "Twitter", "href": "{{twitterUrl}}" },
      { "label": "Pump.fun", "href": "{{pumpFunUrl}}" },
      { "label": "Docs", "href": "{{docsUrl}}" }
    ],
    "legal": "This page is generated by Forge v1.0. Always DYOR."
  }
}
